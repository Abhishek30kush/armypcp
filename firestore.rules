rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Applications collection: allow public creation, but restricted reads/updates
    match /applications/{applicationId} {
      // Allow anyone to submit a new application
      allow create: if true;
      
      // Allow reading and updating if they know the ID
      // This is necessary for the current flow where the ID is generated on client
      allow read, update: if true;
    }
    
    // User profiles: strictly owner-only for sensitive data
    // But allow creation/merge on login
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

