rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Applications collection: allow public creation, but restricted reads/updates
    match /applications/{applicationId} {
      // Allow anyone to submit a new application
      allow create: if true;
      
      // Allow reading and updating if they know the ID (or we could restrict further)
      allow read, update: if true;
    }
    
    // User profiles: strictly owner-only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
